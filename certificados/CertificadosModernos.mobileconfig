	<key>PayloadDescription</key>
	<string>Instala las raices de certificacion modernas (Let's Encrypt, Google y DigiCert) que iOS 9.3.5 no incluye. Sin ellas, las conexiones HTTPS fallan aunque la red sea correcta.</string>
	<key>PayloadDisplayName</key>
	<string>Certificados modernos (Tube9)</string>
	<key>PayloadIdentifier</key>
	<string>com.lofturb.tube9.certificados</string>
